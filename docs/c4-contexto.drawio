<mxfile host="app.diagrams.net" modified="2026-08-27T00:00:00.000Z" agent="ChatGPT" version="24.7.17"><diagram id="tapr-context" name="Página-1"><mxGraphModel dx="1800" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;C4 – Diagrama de Contexto | Sistema TAPR&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:14px'&gt;Plataforma analítica para consolidação e visualização de dados de IT Service Management&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="900" height="70" as="geometry" /></mxCell><mxCell id="azure" value="Hospedagem: Microsoft Azure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6BAED6;dashed=1;fontColor=#08427B;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="570" y="210" width="610" height="390" as="geometry" /></mxCell><mxCell id="tapr" value="&lt;b&gt;Sistema TAPR&lt;/b&gt;&lt;br&gt;&lt;br&gt;Plataforma analítica em Python executada por Azure Functions.&lt;br&gt;&lt;br&gt;Extrai dados, resolve relacionamentos e realiza upsert no repositório analítico." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#08427B;fontColor=#FFFFFF;fontSize=17;align=center;verticalAlign=middle;spacing=14;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="610" y="280" width="530" height="285" as="geometry" /></mxCell><mxCell id="person" value="&lt;b&gt;Gestores / Equipe de TI&lt;/b&gt;&lt;br&gt;&lt;br&gt;Consultam indicadores e utilizam dashboards para acompanhamento operacional." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#555555;fontColor=#1F2937;fontSize=16;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;" ve