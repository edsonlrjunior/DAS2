enta de BI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D1D5DB;fontColor=#1F2937;fontSize=15;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="70" y="895" width="1570" height="95" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>